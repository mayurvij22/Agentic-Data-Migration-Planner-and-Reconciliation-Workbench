# Gemini AI API Key (required for AI agent features)
# Use the literal value "mock" to run the AI agent without a real key
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini model id (optional, defaults to gemini-3.5-flash)
# Older generations get retired — if you see a 404 for the model, set a
# current id from https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.5-flash

# Server port (optional, defaults to 3001)
PORT=3001

# Node environment
NODE_ENV=development
